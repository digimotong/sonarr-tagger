# Copy to .env (or paste into your compose file) and fill in the required values.
# Docker Compose reads this automatically when it sits next to the compose file.

# --- Required -----------------------------------------------------------------
# Sonarr instance URL, reachable from inside the container.
SONARR_URL=http://sonarr:8989
# Sonarr API key with write permissions (Settings -> General -> Security).
SONARR_API_KEY=your-api-key

# --- Optional -----------------------------------------------------------------
# Case-insensitive. One of DEBUG, INFO, WARNING, ERROR, CRITICAL.
# An unknown value aborts startup with "Configuration error".
LOG_LEVEL=INFO
# Score above which the positive-score tag is applied (strictly greater-than).
SCORE_THRESHOLD=100
# Whole number of minutes between runs, minimum 1. 0 or a negative value aborts
# startup rather than turning the loop into a busy loop.
INTERVAL_MINUTES=20
# Any value other than "true" leaves the feature disabled.
TAG_MOTONG=false
TAG_4K=false
TAG_MIXED_RELEASE_GROUPS=false
MONITOR_EXISTING_SPECIALS=false

# --- Notes --------------------------------------------------------------------
# Every Sonarr HTTP request uses a 30 second timeout, so a stalled connection
# fails the cycle (and is retried after 5 minutes) instead of hanging forever.
